{
  "name": "pastie-server-dashboard",
  "version": "1.0.0",
  "description": "Backend server and Admin Dashboard for managing chats, translation, and OTP authentication.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "clear:chat-data": "node clear-chat-data.js",
    "vapid:generate": "web-push generate-vapid-keys",
    "seed:menu": "node scripts/seed-menu.js",
    "seed:menu:clean": "node scripts/seed-menu.js --clean",
    "test": "node tests/order-retention.test.js",
    "cleanup:devices": "node scripts/cleanup-device-data.js",
    "cleanup:old-data": "node scripts/cleanup-device-data.js",
    "cleanup:project": "node scripts/cleanup-device-data.js --project",
    "cleanup:admin": "node scripts/cleanup-device-data.js --admin",
    "capacity": "node scripts/online-capacity.js",
    "upload:guide-s3": "node scripts/upload-guide-to-s3.js"
  },
  "keywords": [
    "chat",
    "admin-dashboard",
    "backend",
    "translation",
    "gemini",
    "postgres",
    "otp",
    "resend"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.11.0",
    "aws4fetch": "^1.0.20",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^2.2.0",
    "node-cron": "^4.2.1",
    "pdfkit": "^0.20.1",
    "pg": "^8.11.5",
    "resend": "^3.2.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7"
  }
}
